{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(memory_http_requests_total[5m])) by (path)",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ],
      "title": "HTTP 请求速率 (按路径)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(memory_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "p95 {{path}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(memory_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "p50 {{path}}",
          "refId": "B"
        }
      ],
      "title": "HTTP 延迟 p50 / p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "memory_dlq_records",
          "legendFormat": "DLQ backlog",
          "refId": "A"
        }
      ],
      "title": "DLQ 积压条数",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(memory_dlq_reconcile_success_total[5m])) by (target)",
          "legendFormat": "ok {{target}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(memory_dlq_reconcile_failure_total[5m])) by (target)",
          "legendFormat": "fail {{target}}",
          "refId": "B"
        }
      ],
      "title": "DLQ Reconcile 成功 / 失败",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(memory_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(memory_http_requests_total[5m]))",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "title": "HTTP 5xx 比例",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(rate(memory_background_tasks_submitted_total[5m])) by (backend)",
          "legendFormat": "submitted {{backend}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(memory_background_tasks_failed_total[5m])) by (backend)",
          "legendFormat": "failed {{backend}}",
          "refId": "B"
        }
      ],
      "title": "后台任务提交 / DLQ 失败",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "id": 7,
      "targets": [
        {
          "expr": "sum(rate(memory_http_requests_total{status=\"429\"}[5m]))",
          "legendFormat": "429 rate",
          "refId": "A"
        }
      ],
      "title": "限流 429 速率",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["memory-service", "phase8"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "label": "Datasource",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Memory Service — Phase 8 运维",
  "uid": "memory-service-phase8",
  "version": 1,
  "description": "导入 Grafana：Dashboards → Import → Upload JSON。需 Prometheus 抓取 ``/metrics``（``metrics_enabled: true``）。"
}
