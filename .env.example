# Settings 环境变量样例 —— 复制为 .env 后按需修改。
# 所有变量前缀 MEMORY_，对齐 memory_app/settings.py。

# 服务
# MEMORY_APP_NAME=Memory Service
# MEMORY_DEBUG=false

# MongoDB
# MEMORY_MONGO_URI=mongodb://localhost:27017
# MEMORY_MONGO_DB=memory

# Elasticsearch
# MEMORY_ES_HOSTS=["http://localhost:9200"]
# MEMORY_ES_INDEX_PREFIX=memory

# Milvus
# MEMORY_MILVUS_HOST=localhost
# MEMORY_MILVUS_PORT=19530
# MEMORY_MILVUS_COLLECTION=memory_vectors

# Redis
# MEMORY_REDIS_URL=redis://localhost:6379/0

# 嵌入模型
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_EMBEDDING_DIM=1536

# 功能开关
# MEMORY_ENABLE_GRAPH=false
# MEMORY_ENABLE_FISHER_RAO=false
# MEMORY_AUTH_ENABLED=false
