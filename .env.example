# Settings 环境变量样例 —— 复制为 .env 后按需修改。
# 所有变量前缀 MEMORY_，对齐 memory_app/settings.py。
# 启动期不可变项也可写在 config/bootstrap.yaml（优先级低于环境变量）。

# ── 服务 ──
# MEMORY_APP_NAME=Memory Service
# MEMORY_DEBUG=false

# ── MongoDB ──
# MEMORY_MONGO_URI=mongodb://localhost:27017
# MEMORY_MONGO_DB=memory

# ── Elasticsearch ──
# MEMORY_ES_HOSTS=["http://localhost:9200"]
# MEMORY_ES_INDEX_PREFIX=memory

# ── Milvus ──
# MEMORY_MILVUS_HOST=localhost
# MEMORY_MILVUS_PORT=19530
# MEMORY_MILVUS_COLLECTION=memory_vectors

# ── Redis ──
# MEMORY_REDIS_URL=redis://localhost:6379/0

# ── 配置中心 ──
# MEMORY_CONFIG_CENTER_BACKEND=file
# MEMORY_CONFIG_CENTER_FILE_PATH=config/default.yaml

# ── 鉴权（业务面 Bearer + 管理面 X-Admin-Key）──
# MEMORY_AUTH_ENABLED=false
# MEMORY_API_KEY=your-business-api-key
# MEMORY_ADMIN_API_KEY=your-admin-key
# MEMORY_TENANT_BINDING_ENABLED=false
# MEMORY_JWT_SECRET=
# MEMORY_TRUST_GATEWAY_HEADERS=false

# ── DLQ / 后台任务 ──
# MEMORY_DLQ_BACKEND=memory
# MEMORY_TASK_RUNNER_BACKEND=asyncio
# MEMORY_TASK_QUEUE_KEY=memory:tasks:cold_path
# MEMORY_TASK_RUNNER_CONSUMER_ENABLED=true
# MEMORY_DLQ_RECONCILE_INTERVAL_S=0

# ── 并发预算 ──
# MEMORY_BACKGROUND_MAX_CONCURRENT=32
# MEMORY_SYNC_INDEX_MAX_CONCURRENT=32
# MEMORY_COLD_PATH_LLM_MAX_CONCURRENT=8

# ── 可观测 / 限流 ──
# MEMORY_METRICS_ENABLED=false
# MEMORY_RATE_LIMIT_ENABLED=false
# MEMORY_RATE_LIMIT_RPM=120

# ── Bootstrap 重定向 ──
# MEMORY_BOOTSTRAP_FILE=config/bootstrap.yaml
